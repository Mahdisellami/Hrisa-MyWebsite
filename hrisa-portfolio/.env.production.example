# Production Environment Variables
# Copy these to Vercel Environment Variables

# ===============================================
# REQUIRED - Email Service (Resend)
# ===============================================
RESEND_API_KEY=your_resend_api_key_here

# ===============================================
# ADMIN CONFIGURATION
# ===============================================
ADMIN_EMAIL=noreply@hrisa.tech

# ===============================================
# APPLICATION URL
# ===============================================
BASE_URL=https://hrisa.tech

# ===============================================
# PRODUCTION - Turso Cloud Database
# ===============================================
# Get from: https://turso.tech
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===============================================
# NOTES
# ===============================================
# - Do NOT commit this file with real values
# - Add these variables in Vercel Dashboard → Environment Variables
# - Do NOT add DATABASE_PATH for production (Turso is used instead)
